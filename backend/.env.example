APP_NAME=ClauseGuard AI
DEBUG=true
VERSION=1.0.0

# Database (choose one)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/clauseguard
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=clauseguard

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# NLP Models (downloads automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RISK_MODEL=dslim/bert-base-NER

# CORS
FRONTEND_URL=http://localhost:5173
